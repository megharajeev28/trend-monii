# Copy this file to frontend/.env and/or backend/.env and fill in values as needed.
# TrendMoni works fully in Demo Mode with none of these set.

# --- Frontend (frontend/.env) ---
# URL of the FastAPI backend. Leave unset to run the frontend standalone on demo data.
VITE_API_URL=

# --- Backend (backend/.env) ---
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only required if/when real data providers replace the demo provider in
# backend/app/providers/. Never expose these to the frontend.
OPENAI_API_KEY=
NEWS_API_KEY=
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
